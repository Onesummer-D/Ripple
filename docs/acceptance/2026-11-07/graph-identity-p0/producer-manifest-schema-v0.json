{
  "schemaName": "ripple-graph-producer-manifest",
  "schemaVersion": "graph-producer-manifest/v1",
  "status": "design-only",
  "identity": {
    "graphIdentityVersion": "sourcegraph-identity/v2",
    "graphSchemaVersion": "acp6-sourcegraph/v1",
    "relationIdentityVersion": "relation-id/v1",
    "rawArtifactVersion": "raw-sourcegraph/v1",
    "producerEvidenceVersion": "producer-evidence/v1",
    "policyManifestVersion": "producer-policy/v1"
  },
  "required": [
    "project",
    "sourceDigest",
    "sourceBindings",
    "analyzerBuild",
    "rawGraphArtifact",
    "producerEvidence",
    "policyManifest",
    "graphDigestStatus"
  ],
  "project": {
    "requestedProjectSha": "b244f857457d2a07f118155602eef9097fd322bd",
    "checkoutHead": "<full git sha>",
    "exactCheckout": "boolean",
    "projectId": "<host registry id>"
  },
  "sourceDigest": "<64 lowercase hex>",
  "sourceBindings": {
    "itemFields": ["role", "path", "sourceFileSha256"],
    "pathRule": "repository-relative POSIX; no absolute, traversal, backslash, NUL, duplicate separator",
    "sortKey": ["role", "path", "sourceFileSha256"],
    "encodingRule": "raw UTF-8 bytes; no newline or Unicode normalization"
  },
  "analyzerBuild": {
    "fields": ["implementationSha", "implementationTree", "relevantBlobs", "toolVersion", "lockfileSha256"],
    "relevantBlobFields": ["path", "blobSha"],
    "identityRule": "all fields verified against the run that emitted rawGraphArtifact"
  },
  "rawGraphArtifact": {
    "artifactVersion": "raw-sourcegraph/v1",
    "fields": ["artifactVersion", "nodes", "edges", "unresolved", "sourceBindings"],
    "arraySortKeys": {
      "nodes": ["id", "kind", "sourceRef", "payloadSha256"],
      "edges": ["relationId", "kind", "from", "to", "certainty", "payloadSha256", "sourceUse.path", "sourceUse.byteOffset", "sourceUse.charOffset", "selectorScope.raw", "mediaContext"],
      "unresolved": ["id", "reason", "sourceRef", "byteOffset", "charOffset"],
      "sourceBindings": ["role", "path", "sourceFileSha256"]
    },
    "hash": "sha256(UTF8(canonicalJson))",
    "duplicateRule": "preserve equal sort-key occurrences in raw artifact; reject duplicate node/relation identity before trusted final digest",
    "shaField": "rawGraphArtifactSha256"
  },
  "producerEvidence": {
    "evidenceVersion": "producer-evidence/v1",
    "fields": ["evidenceVersion", "graphIdentityVersion", "rawGraphArtifactSha256", "analyzerBuild", "edgeOccurrences"],
    "edgeOccurrenceFields": ["occurrenceOrdinal", "relationId", "payloadSha256", "producerPolicyId", "producerIdentity", "producerContractVersion", "policyVersion"],
    "lookupKey": ["rawGraphArtifactSha256", "occurrenceOrdinal", "relationId", "payloadSha256"],
    "completeness": "each canonical edge occurrence exactly once",
    "failure": "missing, duplicate or conflicting record => producerEvidenceStatus=rejected and graphDigestStatus=unavailable"
  },
  "policyManifest": {
    "policyManifestVersion": "producer-policy/v1",
    "fields": ["policyManifestVersion", "graphIdentityVersion", "rawGraphArtifactSha256", "producerEvidenceSha256", "producerPolicies"],
    "producerPolicyFields": ["policyId", "producerIdentity", "relationIdentityVersion", "relationKinds", "certaintySet", "mode", "producerEvidenceRef"],
    "sort": {"producerPolicies": ["policyId"], "relationKinds": "UTF-8 lexicographic", "certaintySet": "UTF-8 lexicographic"},
    "mappingRule": "every edge occurrence matches exactly one policy; no inference from id prefix, endpoint or certainty",
    "shaField": "policyManifestSha256",
    "cycleRule": "exclude policyManifestSha256 and graphDigestSha256 from canonical policy bytes"
  },
  "finalGraphDigest": {
    "fields": ["graphIdentityVersion", "rawGraphArtifactSha256", "producerEvidenceSha256", "policyManifestSha256", "sourceBindings", "nodes", "edgeOccurrences", "unresolved"],
    "domainPrefix": "ripple/sourcegraph-identity/v2/graphDigest\u0000",
    "formula": "sha256(UTF8(domainPrefix) || UTF8(canonicalJson(finalGraphDigestInput)))",
    "unavailableWhen": ["missing producer evidence", "duplicate producer evidence", "conflicting policy mapping", "unknown field", "duplicate node id", "duplicate relation id", "unknown endpoint", "untrusted source binding", "missing analyzer build"],
    "notAuthorization": ["does not prove sourceRef", "does not prove source-proven", "does not prove runtime-observed", "does not grant Candidate/Scope/Verification/Approval/Apply/Rollback"]
  },
  "legacyPolicy": {
    "producerIdentity": "legacy-default",
    "relationIdentityVersion": "legacy",
    "rule": "legacy Relation ids remain readable and are still uniqueness-checked; they are not upgraded into relation-id/v1"
  },
  "prohibited": [
    "emission-order identity",
    "array-index identity",
    "random or time input",
    "silent deduplication",
    "global renumbering",
    "producer inference from Relation.id prefix",
    "semantic-candidate to source-proven upgrade",
    "B v5 threshold changes"
  ]
}
